# Copie para override/config.env e preencha. O config.env nao vai para o git.

# Celular que recebe o codigo de liberacao, com DDI e DDD, so digitos.
# E o unico numero que o servidor avisa. Sem isso, /override/request devolve 503.
OVERRIDE_GESTORA_PHONE=

# Segredo do servidor usado no HMAC do codigo. Gere um valor longo e aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Trocar este valor invalida todos os codigos pendentes.
OVERRIDE_PEPPER=

# Validade do codigo em segundos (padrao 300 = 5 min).
OVERRIDE_TTL_SECONDS=300

# Tentativas erradas antes de queimar o codigo (padrao 3).
OVERRIDE_MAX_ATTEMPTS=3

# Quantidade de digitos do codigo (padrao 6).
OVERRIDE_CODE_DIGITS=6
