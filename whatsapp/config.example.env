# Copie para whatsapp/config.env. O config.env nao vai para o git.
#
# Qual provedor de WhatsApp o /whatscheck e o /override/request usam.
# Aceita apenas dois valores:
#
#   zapi     Z-API      -> le zapi/instances.json
#                          https://api.z-api.io, header Client-Token
#                          GET  /phone-exists/{numero}
#                          POST /send-text
#
#   uazapi   uazapiGO   -> le uazapi/instances.json
#                          https://{subdominio}.uazapi.com, header token
#                          POST /chat/check   {"numbers": ["5585..."]}
#                          POST /send/text    {"number": "...", "text": "..."}
#
# Vazio ou valor desconhecido cai em zapi.
# Depois de trocar, REINICIE o servidor: o valor e lido no import.
# Confira o que esta valendo em GET /health -> {"ok": true, "whatsapp": "..."}
#
# Os dois arquivos de instancias podem ficar no disco ao mesmo tempo.
# So o do provedor escolhido e lido, entao da para voltar atras sem perder nada.
WHATSAPP_PROVIDER=zapi
