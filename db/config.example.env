# Copie para db/config.env e preencha. O config.env nao vai para o git.
#
# Conexao com o SQL Server do SACI, em formato ODBC (nao OLE DB).
# O SACI usa OLE BD em C:\Arquivos Saci\conexao.udl com Provider=SQLOLEDB.1.
# O servidor e o banco sao os mesmos; so a sintaxe muda.
#
# Exemplo com usuario do SQL Server:
#   DB_ODBC_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=10.0.0.5,1433;DATABASE=SACI;UID=usuario;PWD=senha;TrustServerCertificate=yes
#
# Exemplo com autenticacao integrada do Windows (sem usuario e senha no arquivo):
#   DB_ODBC_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=10.0.0.5,1433;DATABASE=SACI;Trusted_Connection=yes;TrustServerCertificate=yes
#
# Precisa do driver instalado na maquina ("ODBC Driver 17 for SQL Server" ou 18)
# e do pacote pyodbc do requirements.txt.
DB_ODBC_CONNECTION_STRING=

# Timeout de conexao em segundos (padrao 10).
DB_TIMEOUT_SECONDS=10
